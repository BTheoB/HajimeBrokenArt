<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=b190ba39eace1434b9834503dfcfb6e7&amp;type=3#MainMenuStyle" />
    <engine:VisualElement name="MainContainer" style="width: 100%; height: 100%;">
        <engine:VisualElement name="SmokedBackground" style="flex-grow: 1; background-color: rgb(0, 0, 0); position: absolute; width: 100%; height: 100%; opacity: 0.35;" />
        <engine:VisualElement name="ScoreContainer" style="flex-grow: 0; align-items: center; flex-direction: row; left: auto; top: auto; margin-top: 20%; margin-left: 25%;">
            <engine:Label text="Score : " name="ScoreLabel" style="font-size: 145px; color: rgb(255, 250, 108); opacity: 1; margin-right: 42px;" />
            <engine:Label text="69100" name="ScoreNumber" style="color: rgb(132, 193, 17); font-size: 70px; top: 5%;" />
        </engine:VisualElement>
        <engine:VisualElement name="ButtonContainer" style="flex-grow: initial; flex-direction: row; flex-shrink: 1; justify-content: space-evenly; margin-top: 10%; opacity: 1; align-items: stretch; align-content: flex-start;">
            <engine:Button text="Reprendre" name="ReprendreButton" class="button" />
            <engine:Button text="Options" name="OptionButton" double-click-selects-word="true" class="button" />
            <engine:Button text="Quitter" name="QuitterButton" class="button" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
