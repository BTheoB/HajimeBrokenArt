<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=b190ba39eace1434b9834503dfcfb6e7&amp;type=3#MainMenuStyle" />
    <engine:VisualElement name="MainContainer" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/mainMenu/image/backgroundMainMenu.jpeg?fileID=2800000&amp;guid=b55c47d34f41ba4409bf1bc1f7892897&amp;type=3#backgroundMainMenu&quot;);">
        <engine:VisualElement name="Container" style="flex-grow: 0; flex-shrink: 0;">
            <engine:Label text="Faut trouver un nom :s&#10;" name="Header" class="header" style="top: 184%; transition-property: all; transition-duration: 1s; transition-timing-function: ease; transition-delay: 0s;" />
        </engine:VisualElement>
        <engine:VisualElement name="ContainerButtons" style="flex-grow: 0; flex-direction: row; flex-shrink: 0; height: 30%; align-content: flex-start; align-self: auto; justify-content: space-evenly; align-items: auto; visibility: visible; overflow: visible; bottom: auto; top: 52%;">
            <engine:Button text="Jouer" name="JouerButton" class="button" style="background-image: url(&quot;project://database/Assets/Art/Ruby/UI/NPCPortrait.png?fileID=2800000&amp;guid=520dfc803cded8c43854cf4275f96485&amp;type=3#NPCPortrait&quot;); height: 100%; width: 25%; -unity-background-scale-mode: stretch-to-fill; background-repeat: no-repeat no-repeat; background-size: cover; background-position-y: center 0;" />
            <engine:Button text="Quitter" name="QuitterButton" class="button" style="background-image: url(&quot;project://database/Assets/Art/Ducko/UI/NPCPortrait.png?fileID=2800000&amp;guid=ad6d5d211152d324b8ef896c9bc013a5&amp;type=3#NPCPortrait&quot;); height: 100%; width: 25%; background-size: cover; -unity-background-scale-mode: scale-and-crop; background-position-y: center 0; background-repeat: no-repeat no-repeat;" />
            <engine:Button text="Scores" name="ScoreButton" class="button" style="background-image: url(&quot;project://database/Assets/Art/SugarLand/UI/NPCPortrait.png?fileID=2800000&amp;guid=23a67005841c5a048b33d1bef5d53c4a&amp;type=3#NPCPortrait&quot;); height: 100%; width: 25%; background-size: cover; -unity-background-scale-mode: scale-and-crop; background-repeat: no-repeat no-repeat; background-position-y: bottom -300px; background-position-x: center 0;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
