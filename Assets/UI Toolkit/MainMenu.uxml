<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=b190ba39eace1434b9834503dfcfb6e7&amp;type=3#MainMenuStyle" />
    <engine:VisualElement name="MainContainer" style="flex-grow: 0; flex-shrink: initial; background-image: url(&quot;project://database/Assets/mainMenu/image/Viewing%20the%20Red%20Planet%20_%20.%20.%20.jpg?fileID=2800000&amp;guid=b843140f8a23fbb449be9b390b56f8a4&amp;type=3#Viewing the Red Planet _ . . &quot;); height: 100%; width: 100%; background-size: cover; background-repeat: no-repeat no-repeat; background-position-x: left 0; background-position-y: top 42%; transition-duration: 0.7s;">
        <engine:VisualElement name="TitleContainer" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/imports/GUI/5%20Logo/Logo1.png?fileID=2800000&amp;guid=e7e1f6272290f844c9e17852cece095b&amp;type=3#Logo1&quot;); justify-content: center; align-items: center; align-self: center; width: 80%; height: 30%; -unity-background-scale-mode: stretch-to-fill; background-size: 50% 100%; flex-shrink: 0; align-content: flex-start; margin-bottom: 0; top: 0; margin-top: 5%;">
            <engine:Label text="Nom du jeU" name="Titre" class="header" style="align-items: auto; margin-top: 3%; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/imports/Fonts/Xirod.otf?fileID=12800000&amp;guid=f87ed6cdaf64a6146a0e45576b8d588a&amp;type=3#Xirod&quot;); width: 100%; height: 100%; font-size: 66%; justify-content: flex-start; align-self: flex-start; flex-basis: auto; top: 48px; text-overflow: clip; white-space: nowrap; opacity: 1;" />
        </engine:VisualElement>
        <engine:VisualElement name="ContainerButtons" style="width: auto; height: auto; flex-shrink: 0; flex-direction: row; align-items: stretch; justify-content: space-evenly; top: 357px; display: flex; visibility: visible;">
            <engine:Button text="Jouer" name="StartButton" selectable="false" class="button" style="height: 150%; width: 20%;" />
            <engine:Button text="Scores" name="ScoreButton" class="button" style="height: 150%; width: 20%;" />
            <engine:Button text="Quitter" name="QuitButton" class="button" style="height: 150%; width: 20%;" />
        </engine:VisualElement>
